{
  "name": "hockey-gm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm -w packages/engine run test && npm -w apps/debug run test && npm -w apps/viewer run test",
    "test:picture": "npm -w apps/viewer run test:picture",
    "test:calibration": "npm -w packages/engine run test:calibration",
    "bench": "tsx packages/engine/scripts/bench.ts",
    "typecheck": "tsc --noEmit -p packages/engine/tsconfig.json && tsc --noEmit -p packages/engine/tsconfig.test.json && npm -w apps/debug run typecheck && npm -w apps/viewer run typecheck",
    "calibrate": "tsx packages/engine/scripts/calibrate.ts",
    "scorecard": "tsx packages/engine/scripts/scorecard.ts",
    "debug": "npm -w apps/debug run dev",
    "viewer": "npm -w apps/viewer run dev",
    "test:browser": "npm -w packages/engine run test:browser",
    "golden:update": "npm -w packages/engine run golden:update"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
